# Copie ce fichier en .env (sans le .example) et remplis les valeurs.
# Si tu laisses REDDIT_CLIENT_ID et REDDIT_CLIENT_SECRET vides,
# le module Reddit bascule automatiquement sur l'API JSON publique
# (sans authentification, rate-limit plus strict mais fonctionnel).

# --- Reddit (facultatif mais recommandé) ---
# Crée une app type "script" sur https://www.reddit.com/prefs/apps
# (champs "redirect uri" : http://localhost:8080 ; le reste peu importe)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=WiXplain-VeilleBot/1.0 (contact: senach.moy@gmail.com)
